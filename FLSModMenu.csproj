<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FLSModMenu</AssemblyName>
    <RootNamespace>FLSModMenu</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Path to the game; override with -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Football Life Simulator</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\net6\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppVContainer.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.ScreenCaptureModule.dll" Private="false" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>
</Project>
